# Local run (BYOK Foundry model via your Azure CLI identity):
FOUNDRY_PROJECT_ENDPOINT=https://amantara-hosted-agents-eastus2.services.ai.azure.com/api/projects/amantara-hosted-agents-eastus2
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-luna
TOOLBOX_NAME=f100-public-library-3d1-toolbox
TOOLBOX_VERSION=1
TOOLBOX_DISCOVER_TOOLS=true
FOUNDRY_AGENT_NAME=public-library-3d1
AZURE_CONTENT_SAFETY_ENDPOINT=https://amantara-hosted-agents-eastus2.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_INCIDENTS=f100-public-library-3d1-patron-privacy-violation
AZURE_CONTENT_SAFETY_ACTIVATION_RULES="[{\"name\": \"f100-public-library-3d1-patron-privacy-violation\", \"activation_terms\": [\"PRIVACY-BREACH-001\"]}]"
# Per-user Foundry memory. Local runs have no platform user id, so memory stays off here.
MEMORY_STORE_NAME=
# Required only when publishing the generated APIM/MCP resources manually.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_API_MANAGEMENT_RESOURCE_GROUP=
AZURE_API_MANAGEMENT_NAME=
AZURE_API_MANAGEMENT_GATEWAY_URL=
AZURE_APIM_MCP_AUDIENCE=
# The default port 8088 may be taken on your machine.
PORT=8089
